@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Se produjo un error al procesar su solicitud.</h2>

@if (Model?.ShowRequestId ?? false)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Cambiar al entorno de <strong>Desarrollo</strong> mostrará información más detallada sobre el error que se produjo.
</p>
<p>
    <strong>El entorno de desarrollo no debe habilitarse para aplicaciones implementadas.</strong> Puede dar lugar a que la información confidencial de las excepciones se muestre a los usuarios finales. Para las aplicaciones de producción, el entorno de <strong>Desarrollo</strong> se puede deshabilitar estableciendo la variable de entorno <code>ASPNETCORE_ENVIRONMENT</code> en <code>Production</code>.
</p>
