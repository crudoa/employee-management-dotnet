@model IEnumerable<MyperPrueba.Models.Trabajador>

@{
    ViewData["Title"] = "Lista de Trabajadores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="fas fa-users"></i> Lista de Trabajadores
        </h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle"></i> Crear Nuevo
        </a>
    </div>

    <div class="mb-3">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <label for="sexFilter" class="input-group-text">Filtrar por Sexo:</label>
                <select name="sexFilter" id="sexFilter" class="form-select">
                    <option value="">Todos</option>
                    <option value="M"> @(ViewBag.SexFilter == "M" ? "selected" : "")>Masculino</option>
                    <option value="F"> @(ViewBag.SexFilter == "F" ? "selected" : "")>Femenino</option>
                </select>
                <button type="submit" class="btn btn-outline-secondary">Aplicar Filtro</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar Filtro</a>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.TipoDocumento)</th>
                    <th>@Html.DisplayNameFor(model => model.NumeroDocumento)</th>
                    <th>@Html.DisplayNameFor(model => model.Nombres)</th>
                    <th>@Html.DisplayNameFor(model => model.Sexo)</th>
                    <th>@Html.DisplayNameFor(model => model.Departamento)</th>
                    <th>@Html.DisplayNameFor(model => model.Provincia)</th>
                    <th>@Html.DisplayNameFor(model => model.Distrito)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.Sexo == "M" ? "table-info" : (item.Sexo == "F" ? "table-danger" : ""))">
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.TipoDocumento)</td>
                        <td>@Html.DisplayFor(modelItem => item.NumeroDocumento)</td>
                        <td>@Html.DisplayFor(modelItem => item.Nombres)</td>
                        <td>@Html.DisplayFor(modelItem => item.Sexo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Departamento.NombreDepartamento)</td>
                        <td>@Html.DisplayFor(modelItem => item.Provincia.NombreProvincia)</td>
                        <td>@Html.DisplayFor(modelItem => item.Distrito.NombreDistrito)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detalles">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Script para mantener el filtro de sexo seleccionado
        $(document).ready(function () {
            var sexFilter = '@ViewBag.SexFilter';
            if (sexFilter) {
                $('#sexFilter').val(sexFilter);
            }
        });
    </script>
}
